# Copy to .env and fill in real values.
# Never commit .env.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_validations,write_delivery_customizations
SHOPIFY_APP_URL=https://your-app.example.com

# Optional: set to "false" in production to charge real money
BILLING_TEST=true

# Optional: override the shop domain used in the proxy
# SHOP_CUSTOM_DOMAIN=myshop.myshopify.com
